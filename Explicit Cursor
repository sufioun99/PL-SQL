DECLARE
  CURSOR emp_cursor IS SELECT * FROM emp;
  v_emp emp_cursor%rowtype;
BEGIN

	DBMS_OUTPUT.PUT_LINE ('**********************%ISOPEN Test***********************');
	IF emp_cursor%ISOPEN THEN
		NULL;
	ELSE  
		OPEN emp_cursor;
	END IF;	

	--WHILE emp_cursor%found
	LOOP
		FETCH emp_cursor into v_emp;
		EXIT WHEN  emp_cursor%NOTFOUND;
		DBMS_OUTPUT.PUT_LINE(v_emp.ename||','||v_emp.empno);
	END LOOP;

	DBMS_OUTPUT.PUT_LINE ('*******************%ROWCOUNT Test***********************');
	DBMS_OUTPUT.PUT_LINE('Total records in emp table - '||emp_cursor%ROWCOUNT);
	CLOSE emp_cursor;
    DBMS_OUTPUT.PUT_LINE ('******%NOTFOUND Test - Reached the end of cursor********');
END;
/



/****************************
IF query of the cursor 
1) returns 0 record then emp_cursor%FOUND will be FALSE
2) returns 1 or more record then emp_cursor%FOUND will be TRUE

*/

DECLARE
  CURSOR emp_cursor IS SELECT * FROM emp WHERE empno = 1001; --7369
  v_emp emp_cursor%rowtype;
BEGIN
    OPEN emp_cursor;
    FETCH emp_cursor INTO v_emp;
	
	DBMS_OUTPUT.PUT_LINE ('**********************%FOUND Test***********************');
	IF emp_cursor%FOUND THEN
		DBMS_OUTPUT.PUT_LINE ('emp_cursor%FOUND :'||'TRUE'); 
	ELSE  
		DBMS_OUTPUT.PUT_LINE ('emp_cursor%FOUND :'||'FALSE');
	END IF;	

END;

