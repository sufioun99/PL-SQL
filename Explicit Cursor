DECLARE
    CURSOR emp_cursor (v_deptno NUMBER) IS 
        SELECT * FROM emp WHERE deptno = v_deptno;
BEGIN
    -- The FOR loop automatically opens, fetches, passes the parameter, and closes!
    FOR v_emp IN emp_cursor(10) LOOP
        DBMS_OUTPUT.PUT_LINE(v_emp.ename || ',' || v_emp.empno);
    END LOOP;
END;
/

