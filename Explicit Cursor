DECLARE
    CURSOR cursor_name (p_seat_number VARCHAR2) IS
		SELECT *
		FROM FLIGHT_SEATS_MAP 
		WHERE flight_id = 1 AND seat_no IN (p_seat_number) FOR UPDATE NOWAIT;
    v_seat_no  VARCHAR2(10) := '04A';
BEGIN

  --Ticket booking happening here
  FOR cur_rec IN cursor_name(v_seat_no) LOOP
       
       INSERT INTO FLIGHT_BOOKING VALUES (seq_booking_id.NEXTVAL, 1, 1, v_seat_no, SYSDATE);
       --Let delay the execution for 10 seconds
       SYS.DBMS_SESSION.SLEEP(10);	   
  END LOOP;
  --Commit to release the lock  
  COMMIT;

  DBMS_OUTPUT.PUT_LINE ('Booking successful for seat no - '||v_seat_no); 

EXCEPTION
  WHEN OTHERS THEN
    DBMS_OUTPUT.PUT_LINE ('Seat - '||v_seat_no||' is being booked by an another user');   
END;    
    
